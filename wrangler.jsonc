{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accounts-yaoxi-cloud",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "node build.js"
  }
}
